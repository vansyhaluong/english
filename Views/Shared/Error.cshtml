@model ErrorViewModel
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Layout = User.IsInRole(nameof(UserRole.Admin))
        ? "_AdminLayout"
        : User.IsInRole(nameof(UserRole.Student))
            ? "_StudentLayout"
            : "_Layout";
    var titleKey = Model.StatusCode switch
    {
        403 => "Error403Title",
        404 => "Error404Title",
        _ => "Error500Title"
    };
    var messageKey = Model.StatusCode switch
    {
        403 => "Error403Message",
        404 => "Error404Message",
        _ => "Error500Message"
    };
    ViewData["Title"] = L[titleKey];
}

<section class="area-error" aria-labelledby="error-title">
    <div class="area-error-card">
        <div class="area-error-code" aria-hidden="true">@Model.StatusCode</div>
        <h1 id="error-title">@L[titleKey]</h1>
        <p>@L[messageKey]</p>
        <a asp-controller="Home" asp-action="Index" asp-route-culture="@culture">@L["ReturnHome"]</a>
    </div>
</section>
