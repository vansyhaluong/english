@{
    ViewData["Title"] = "Trang chủ";
}

<!-- HERO SECTION -->
<section id="desk" class="desk-section" aria-labelledby="desk-title">
    <div class="desk-intro">
        <span class="desk-greeting"><span aria-hidden="true">☀</span> Một chút tiếng Anh mỗi ngày</span>
        <h1 id="desk-title" class="desk-title">Bàn học của bạn</h1>
        <p class="desk-subtitle">Chọn một mục bên dưới để bắt đầu.</p>

        <div class="hero-actions">
            <a href="#features" class="btn-brand-primary">
                Bắt đầu học ngay
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                </svg>
            </a>
        </div>

        <nav class="desk-shortcuts" aria-label="Chọn kỹ năng">
            <a href="/vocabulary"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6v15 M12 6C9 3 5 3 2 4v15c4-1 7-1 10 2 3-3 6-3 10-2V4c-3-1-7-1-10 2" /></svg>Luyện từ</a>
            <a href="#grammar-showcase"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16v18H4z M8 7h8 M8 11h6" /></svg>Ngữ pháp</a>
            <a href="#listening-showcase"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 14v-2a9 9 0 0 1 18 0v2 M3 13h4v8H3z M17 13h4v8h-4z" /></svg>Nghe &amp; Shadowing</a>
            <a href="#translate-showcase"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 5h12 M7 2v3 M4 14 12 5 M5 8l6 6 M14 21l4-10 4 10 M16 17h4" /></svg>Dịch tiếng Anh</a>
            <a href="#ai-coach"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 21h8 M4 16 16 4l4 4L8 20l-5 1z" /></svg>Luyện viết cùng AI</a>
            <a href="#reading-showcase"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 3h16v18H4z M8 3v7l3-2 3 2V3" /></svg>Đọc sách</a>
            <a href="#conversation-showcase"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3h14v11H7l-4 4z M17 8h4v13l-4-3h-6v-4" /></svg>Hội thoại</a>
            <a href="#exam-showcase"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 9 10-5 10 5-10 5z M6 11v6c4 3 8 3 12 0v-6" /></svg>Luyện thi</a>
        </nav>
        <div class="desk-note" data-phrase-book role="region" aria-label="Một câu tiếng Anh cho bạn">
            <div class="note-sheet">
                <span class="note-label">MỘT CÂU TIẾNG ANH CHO BẠN</span>
                <div class="note-copy" aria-live="off">
                    <p lang="en">A little progress every day adds up.</p>
                    <p class="note-translation">Mỗi ngày tiến bộ một chút, bạn sẽ đi được thật xa.</p>
                </div>
                <span class="note-page-number" aria-hidden="true">01 / 06</span>
            </div>
            <div class="note-controls" hidden>
                <button type="button" data-phrase-pause aria-label="Tạm dừng tự đổi câu" aria-pressed="false">Tạm dừng</button>
                <button type="button" data-phrase-next aria-label="Xem câu tiếng Anh tiếp theo">Câu tiếp <span aria-hidden="true">→</span></button>
            </div>
        </div>
    </div>
    <div class="desk-bottom" aria-label="Bắt đầu hành trình học">
        <a href="#levels" class="desk-tile"><span class="desk-tile-icon">A1–C2</span><span><strong>Lộ trình của bạn</strong><small>Chọn trình độ để bắt đầu</small></span></a>
        <a href="#features" class="desk-tile"><span class="desk-tile-icon" aria-hidden="true">↗</span><span><strong>Học mỗi ngày</strong><small>Từ vựng, nghe và ngữ pháp</small></span></a>
        <a asp-controller="Account" asp-action="Login" class="desk-tile desk-signin">Khám phá cùng EnglishHub <span class="tile-arrow" aria-hidden="true">→</span></a>
    </div>
    <a href="#features" class="desk-explore">Khám phá EnglishHub <span aria-hidden="true">↓</span></a>
</section>

<!-- STATS SECTION -->
