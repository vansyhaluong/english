    <div class="glass-card stats-box">
        <h2 class="stats-label-header">Nội dung đã có sẵn trong EnglishHub</h2>
        <dl class="stats-grid">
            <div class="stat-item">
                <dt class="stat-desc">thẻ từ vựng</dt>
                <dd class="stat-num">17.441</dd>
            </div>
            <div class="stat-item">
                <dt class="stat-desc">bài tập ngữ pháp</dt>
                <dd class="stat-num">2.370</dd>
            </div>
            <div class="stat-item">
                <dt class="stat-desc">câu luyện nghe</dt>
                <dd class="stat-num">1.918</dd>
            </div>
            <div class="stat-item">
                <dt class="stat-desc">câu hỏi đề thi</dt>
                <dd class="stat-num">1.502</dd>
            </div>
            <div class="stat-item">
                <dt class="stat-desc">sách đọc song ngữ</dt>
                <dd class="stat-num">120</dd>
            </div>
            <div class="stat-item">
                <dt class="stat-desc">mục từ điển Anh–Việt</dt>
                <dd class="stat-num">9.828</dd>
            </div>
        </dl>
    </div>
</section>

<!-- FEATURES GRID (Một nền tảng, đủ mọi kỹ năng) -->
<section id="features" class="section-block">
    <div class="section-header-center">
        <h2 class="section-title">Một nền tảng, đủ mọi kỹ năng tiếng Anh</h2>
        <p class="section-desc">Dùng chung một kho nội dung và một lịch ôn tập khoa học.</p>
    </div>

    <div class="features-grid">
        <!-- 1. Từ vựng -->
        <div class="glass-card glass-card-interactive">
            <a href="/vocabulary" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path>
                        <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path>
                        <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Từ vựng</h3>
                <p class="feature-text">17.441 thẻ, 22 bộ công khai. Kèm phiên âm IPA chuẩn, audio, ví dụ và lịch ôn lặp lại ngắt quãng.</p>
            </a>
        </div>

        <!-- 2. Ngữ pháp -->
        <div class="glass-card glass-card-interactive">
            <a href="#grammar-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path>
                        <path d="M8 11h8"></path>
                        <path d="M8 7h6"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Ngữ pháp</h3>
                <p class="feature-text">2.370 câu trong 79 chủ điểm, chấm điểm ngay và giải thích chi tiết cặn kẽ tại chỗ.</p>
            </a>
        </div>

        <!-- 3. Đọc sách -->
        <div class="glass-card glass-card-interactive">
            <a href="#reading-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10 2v8l3-3 3 3V2"></path>
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Đọc sách</h3>
                <p class="feature-text">120 truyện và sách A1–C1. Chạm vào từ mới lạ để tra nghĩa và nghe phát âm bản ngữ ngay khi đọc.</p>
            </a>
        </div>

        <!-- 4. Hội thoại -->
        <div class="glass-card glass-card-interactive">
            <a href="#conversation-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                        <path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Hội thoại</h3>
                <p class="feature-text">50 tình huống giao tiếp đời thường, 718 câu thoại. Nghe từng câu và phản xạ điền từ còn thiếu.</p>
            </a>
        </div>

        <!-- 5. Nghe & Shadowing -->
        <div class="glass-card glass-card-interactive">
            <a href="#listening-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Nghe &amp; Shadowing</h3>
                <p class="feature-text">117 bài nghe video thực tế, 1.918 câu luyện. Nghe, chép chính tả, rồi nói nhại lại chuẩn ngữ điệu.</p>
            </a>
        </div>

        <!-- 6. Dịch -->
        <div class="glass-card glass-card-interactive">
            <a href="#translate-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m5 8 6 6"></path>
                        <path d="m4 14 6-6 2-3"></path>
                        <path d="M2 5h12"></path>
                        <path d="M7 2h1"></path>
                        <path d="m22 22-5-10-5 10"></path>
                        <path d="M14 18h6"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Dịch</h3>
                <p class="feature-text">804 đoạn dịch Việt–Anh, có cả chế độ ghép từ tương tác và chế độ gõ viết cả đoạn.</p>
            </a>
        </div>

        <!-- 7. Viết & Nói với AI -->
        <div class="glass-card glass-card-interactive">
            <a href="#ai-coach" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13 21h8"></path>
                        <path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Viết &amp; Nói với AI</h3>
                <p class="feature-text">50 đề viết, 500 chủ đề nói. AI chấm điểm từng tiêu chí và hướng dẫn sửa lỗi bằng tiếng Việt.</p>
            </a>
        </div>

        <!-- 8. Luyện thi -->
        <div class="glass-card glass-card-interactive">
            <a href="#exam-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"></path>
                        <path d="M22 10v6"></path>
                        <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Luyện thi</h3>
                <p class="feature-text">49 đề IELTS, TOEIC, Cambridge — 1.502 câu hỏi, chia rõ theo từng kỹ năng và bấm giờ như thật.</p>
            </a>
        </div>

        <!-- 9. Từ điển -->
        <div class="glass-card glass-card-interactive">
            <a href="#dict-showcase" class="feature-card">
                <div class="feature-icon-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"></path>
                        <path d="m8 13 4-7 4 7"></path>
                        <path d="M9.1 11h5.7"></path>
                    </svg>
                </div>
                <h3 class="feature-title">Từ điển</h3>
                <p class="feature-text">9.828 mục từ điển Anh–Việt, tra cứu thông minh và lưu thẳng từ mới vào bộ ôn tập.</p>
            </a>
