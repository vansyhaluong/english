@model English.Models.ViewModels.AdminUsers.AdminUserDetailsViewModel
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Layout = "_AdminLayout";
    ViewData["Title"] = L["UserDetails"];
}

<section class="account-page" aria-labelledby="user-details-title">
    <div class="account-card">
        <h1 id="user-details-title">@L["UserDetails"]</h1>

        <dl class="account-readonly">
            <div>
                <dt>@L["FullName"]</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>@L["Email"]</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>@L["Role"]</dt>
                <dd>@L[Model.Role]</dd>
            </div>
            <div>
                <dt>@L["Status"]</dt>
                <dd>@(Model.IsActive ? L["Active"] : L["Locked"])</dd>
            </div>
            <div>
                <dt>@L["CreatedAt"]</dt>
                <dd>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm zzz")</dd>
            </div>
        </dl>

        @if (Model.IsActive)
        {
            <form asp-action="Lock" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post" class="account-form">
                <button type="submit" class="btn-brand-primary">@L["LockAccount"]</button>
            </form>
        }
        else
        {
            <form asp-action="Unlock" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post" class="account-form">
                <button type="submit" class="btn-brand-primary">@L["UnlockAccount"]</button>
            </form>
        }

        <p class="account-switch"><a asp-action="Index" asp-route-culture="@culture">@L["BackToUsers"]</a></p>
    </div>
</section>
