@model English.Models.ViewModels.AdminUsers.AdminUsersIndexViewModel
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Layout = "_AdminLayout";
    ViewData["Title"] = L["ManageUsers"];
}

<section class="account-page" aria-labelledby="users-title">
    <div class="management-card">
        <h1 id="users-title">@L["ManageUsers"]</h1>

        <form asp-action="Index" method="get" class="management-search" role="search">
            <label for="user-search">@L["SearchUsers"]</label>
            <div>
                <input type="hidden" name="culture" value="@culture" />
                <input id="user-search" type="search" name="search" value="@Model.Search" maxlength="256" />
                <button type="submit" class="btn-brand-primary">@L["Search"]</button>
            </div>
        </form>

        @if (Model.Users.Count == 0)
        {
            <p>@L["NoUsersFound"]</p>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>@L["FullName"]</th>
                            <th>@L["Email"]</th>
                            <th>@L["Role"]</th>
                            <th>@L["Status"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@L[user.Role]</td>
                                <td>@(user.IsActive ? L["Active"] : L["Locked"])</td>
                                <td><a asp-action="Details" asp-route-id="@user.Id" asp-route-culture="@culture">@L["Details"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
