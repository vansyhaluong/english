@model English.Models.ViewModels.AdminUsers.AdminUsersIndexViewModel
@{
    ViewData["Title"] = "Quản lý người dùng";
    ViewData["PageClass"] = "account-page-shell";
}

<section class="account-page" aria-labelledby="users-title">
    <div class="management-card">
        <h1 id="users-title">Quản lý người dùng</h1>

        <form asp-action="Index" method="get" class="management-search" role="search">
            <label for="user-search">Tìm theo họ tên hoặc email</label>
            <div>
                <input id="user-search" type="search" name="search" value="@Model.Search" maxlength="256" />
                <button type="submit" class="btn-brand-primary">Tìm kiếm</button>
            </div>
        </form>

        @if (Model.Users.Count == 0)
        {
            <p>Không tìm thấy người dùng.</p>
        }
        else
        {
            <div class="management-table-wrap">
                <table class="management-table">
                    <thead>
                        <tr>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Vai trò</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.Role</td>
                                <td>@(user.IsActive ? "Đang hoạt động" : "Đã khóa")</td>
                                <td><a asp-action="Details" asp-route-id="@user.Id">Chi tiết</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
