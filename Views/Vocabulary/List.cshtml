@model English.Models.ViewModels.Vocabulary.VocabularyListViewModel
@{ Layout = Model.IsAdmin ? "_AdminLayout" : "_StudentLayout"; ViewData["Title"] = L["Vocabulary"]; var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; }
@section Styles { <link rel="stylesheet" href="~/css/vocabulary-content.css" asp-append-version="true" /> }
<section class="account-page vocabulary-content"><div class="management-card">
    <h1>@L["Vocabulary"]</h1>
    @if (TempData["VocabularyMessage"] is string message) { <p class="account-success" role="status">@message</p> }
    @if (Model.IsAdmin) { <p><a asp-action="Create" asp-route-culture="@culture">@L["VocabCreate"]</a></p> }
    <form asp-action="Index" method="get" class="vocabulary-filters">
        <input type="hidden" name="culture" value="@culture" />
        <label>@L["VocabSearch"]<input type="search" name="Search" value="@Model.Query.Search" maxlength="300" /></label>
        <label>@L["Levels"]<select name="LevelId"><option value="">@L["VocabAll"]</option>@foreach (var option in Model.Choices.Levels) { <option value="@option.Id" selected="@(Model.Query.LevelId == option.Id)">@option.Name</option> }</select></label>
        <label>@L["Topics"]<select name="TopicId"><option value="">@L["VocabAll"]</option>@foreach (var option in Model.Choices.Topics) { <option value="@option.Id" selected="@(Model.Query.TopicId == option.Id)">@option.Name</option> }</select></label>
        @if (!Model.IsAdmin) { <label>@L["VocabProgress"]<select name="Learned"><option value="">@L["VocabAll"]</option><option value="true" selected="@(Model.Query.Learned == true)">@L["VocabLearned"]</option><option value="false" selected="@(Model.Query.Learned == false)">@L["VocabUnlearned"]</option></select></label> }
        <button type="submit" class="btn-brand-primary">@L["VocabFilter"]</button><a asp-action="Index" asp-route-culture="@culture">@L["VocabClear"]</a>
    </form>
    @if (Model.Items.Count == 0) { <p>@L["VocabEmpty"]</p> }
    else
    {
        <div class="management-table-wrap"><table class="management-table"><thead><tr><th>@L["VocabTitle"] / @L["VocabWord"]</th><th>@L["VocabMeanings"]</th><th>@L["Levels"] / @L["Topics"]</th><th>@L["VocabStatus"]</th><th>@L["ClassificationActions"]</th></tr></thead><tbody>
        @foreach (var item in Model.Items)
        {
            <tr data-vocabulary-id="@item.Id"><td><strong>@item.Title</strong><p lang="en">@item.Word · @L["VocabPos" + item.PartOfSpeech]</p><p>@item.Pronunciation</p></td><td><ol>@foreach (var meaning in item.Meanings) { <li>@meaning.MeaningVi</li> }</ol></td><td>@item.Level / @item.Topic</td>
                <td>@L[Model.IsAdmin ? (item.IsDeleted ? "VocabDeleted" : item.IsVisible ? "VocabVisible" : "VocabHidden") : item.IsLearned ? "VocabLearned" : "VocabUnlearned"]</td>
                <td>@if (Model.IsAdmin) { @if (!item.IsDeleted) { <a asp-action="Edit" asp-route-id="@item.Id" asp-route-culture="@culture">@L["ClassificationEdit"]</a><br /><a asp-action="Delete" asp-route-id="@item.Id" asp-route-culture="@culture">@L["VocabDelete"]</a> } } else { <a asp-action="Details" asp-route-id="@item.Id" asp-route-culture="@culture">@L["VocabDetails"]</a> }</td>
            </tr>
        }
        </tbody></table></div>
    }
    <nav class="vocabulary-actions" aria-label="@L["VocabPages"]">
        @if (Model.Query.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Query.Page - 1)" asp-route-search="@Model.Query.Search" asp-route-levelId="@Model.Query.LevelId" asp-route-topicId="@Model.Query.TopicId" asp-route-learned="@Model.Query.Learned" asp-route-culture="@culture">@L["VocabPrevious"]</a> }
        <span>@Model.Query.Page / @Model.TotalPages</span>
        @if (Model.Query.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Query.Page + 1)" asp-route-search="@Model.Query.Search" asp-route-levelId="@Model.Query.LevelId" asp-route-topicId="@Model.Query.TopicId" asp-route-learned="@Model.Query.Learned" asp-route-culture="@culture">@L["VocabNext"]</a> }
    </nav>
</div></section>
