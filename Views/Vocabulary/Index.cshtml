@model English.Models.ViewModels.Vocabulary.VocabularyListViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = L["Vocabulary"];
    ViewData["PageClass"] = "vocabulary-page";
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
}
@section Styles { <link rel="stylesheet" href="~/css/vocabulary.css" asp-append-version="true" /> }
<div class="vocabulary">
    <header class="vocab-heading">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 6v15 M12 6C9 3 5 3 2 4v15c4-1 7-1 10 2 3-3 6-3 10-2V4c-3-1-7-1-10 2" /></svg>
        <div><h1>@L["Vocabulary"]</h1><p>@L["VocabSearch"]</p></div>
    </header>
    @if (TempData["VocabularyMessage"] is string message) { <p role="status">@message</p> }
    <section id="decks" aria-labelledby="decks-title">
        <div class="vocab-section-heading"><h2 id="decks-title"><span aria-hidden="true">▱</span> @L["Vocabulary"]</h2></div>
        <form asp-action="Index" method="get" class="vocab-filters" role="search">
            <input type="hidden" name="culture" value="@culture" />
            <label class="vocab-level"><span class="visually-hidden">@L["Levels"]</span><select name="LevelId" aria-label="@L["Levels"]"><option value="">@L["VocabAll"]</option>@foreach (var level in Model.Choices.Levels) { <option value="@level.Id" selected="@(Model.Query.LevelId == level.Id)">@level.Name</option> }</select></label>
            <label class="vocab-level"><span class="visually-hidden">@L["Topics"]</span><select name="TopicId" aria-label="@L["Topics"]"><option value="">@L["VocabAll"]</option>@foreach (var topic in Model.Choices.Topics) { <option value="@topic.Id" selected="@(Model.Query.TopicId == topic.Id)">@topic.Name</option> }</select></label>
            <label class="vocab-level"><span class="visually-hidden">@L["VocabProgress"]</span><select name="Learned" aria-label="@L["VocabProgress"]"><option value="">@L["VocabAll"]</option><option value="true" selected="@(Model.Query.Learned == true)">@L["VocabLearned"]</option><option value="false" selected="@(Model.Query.Learned == false)">@L["VocabUnlearned"]</option></select></label>
            <label class="vocab-search"><span class="visually-hidden">@L["VocabSearch"]</span><input type="search" name="Search" value="@Model.Query.Search" placeholder="@L["VocabSearch"]" maxlength="300" /></label>
            <button class="vocab-filter-button" type="submit">@L["VocabFilter"]</button>
            <a asp-action="Index" asp-route-culture="@culture" class="vocab-reset">@L["VocabClear"]</a>
        </form>
        <div class="vocab-grid">
            @foreach (var item in Model.Items)
            {
                <article class="vocab-deck" data-vocabulary-id="@item.Id">
                    <div class="vocab-deck-heading"><span class="vocab-deck-icon" aria-hidden="true">▱</span><div><h3><a asp-action="Details" asp-route-id="@item.Id" asp-route-culture="@culture">@item.Title</a></h3><div class="vocab-deck-meta"><span class="vocab-badge" data-level="@item.Level">@item.Level</span><span>@item.Topic</span></div></div></div>
                    <p class="vocab-deck-description"><span lang="en">@item.Word</span> · @item.Pronunciation · @L["VocabPos" + item.PartOfSpeech]</p>
                    <p class="vocab-deck-description">@L[item.IsLearned ? "VocabLearned" : "VocabUnlearned"]</p>
                    <div class="vocab-deck-actions"><a asp-action="Details" asp-route-id="@item.Id" asp-route-culture="@culture" class="vocab-study">▷ @L["VocabDetails"]</a></div>
                    <details class="vocab-words"><summary>@L["VocabMeanings"]</summary><ol>@foreach (var meaning in item.Meanings) { <li data-meaning-id="@meaning.Id">@meaning.MeaningVi</li> }</ol></details>
                </article>
            }
        </div>
        @if (Model.Items.Count == 0) { <div class="vocab-empty"><span aria-hidden="true">⌕</span><h3>@L["VocabEmpty"]</h3><a asp-action="Index" asp-route-culture="@culture" class="vocab-text-link">@L["VocabClear"] →</a></div> }
        <nav class="vocab-pagination" aria-label="@L["VocabPages"]">
            @if (Model.Query.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Query.Page - 1)" asp-route-search="@Model.Query.Search" asp-route-levelId="@Model.Query.LevelId" asp-route-topicId="@Model.Query.TopicId" asp-route-learned="@Model.Query.Learned" asp-route-culture="@culture" aria-label="@L["VocabPrevious"]">‹</a> } else { <span aria-disabled="true">‹</span> }
            <p aria-current="page">@Model.Query.Page <span>/ @Model.TotalPages</span></p>
            @if (Model.Query.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Query.Page + 1)" asp-route-search="@Model.Query.Search" asp-route-levelId="@Model.Query.LevelId" asp-route-topicId="@Model.Query.TopicId" asp-route-learned="@Model.Query.Learned" asp-route-culture="@culture" aria-label="@L["VocabNext"]">›</a> } else { <span aria-disabled="true">›</span> }
        </nav>
    </section>
</div>
