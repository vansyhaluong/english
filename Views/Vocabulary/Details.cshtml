@model English.Models.ViewModels.Vocabulary.VocabularyDetailsViewModel
@{ Layout = "_StudentLayout"; ViewData["Title"] = Model.Title; var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; }
@section Styles { <link rel="stylesheet" href="~/css/vocabulary-content.css" asp-append-version="true" /> }
<section class="account-page vocabulary-content"><article class="management-card">
    <h1>@Model.Title</h1><h2 lang="en">@Model.Word</h2><p>@Model.Pronunciation · @L["VocabPos" + Model.PartOfSpeech]</p><p>@Model.Level / @Model.Topic</p>
    @if (TempData["VocabularyMessage"] is string message) { <p role="status">@message</p> }
    @if (!string.IsNullOrEmpty(Model.Description)) { <p class="vocabulary-text">@Model.Description</p> }
    @if (Model.ImageUrl is not null) { <figure><img class="vocabulary-image" src="@Model.ImageUrl" alt="@Model.Word" loading="lazy" referrerpolicy="no-referrer" /><figcaption>@L["VocabMediaHint"]</figcaption></figure> }
    @if (Model.AudioUrl is not null) { <div><audio controls preload="none" src="@Model.AudioUrl">@L["VocabAudioFallback"]</audio><p>@L["VocabMediaHint"]</p></div> }
    <h2>@L["VocabMeanings"]</h2><ol class="vocabulary-text">@foreach (var meaning in Model.Meanings) { <li data-meaning-id="@meaning.Id">@meaning.MeaningVi</li> }</ol>
    <h2>@L["VocabExample"]</h2><p class="vocabulary-text" lang="en">@Model.Example</p>
    <p>@L[Model.IsLearned ? "VocabLearned" : "VocabUnlearned"]</p>
    <form asp-action="Learned" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post"><input type="hidden" name="IsLearned" value="@((!Model.IsLearned).ToString().ToLowerInvariant())" /><button type="submit" class="btn-brand-primary">@L[Model.IsLearned ? "VocabUnmark" : "VocabMark"]</button></form>
    <p><a asp-action="Index" asp-route-culture="@culture">@L["ClassificationBack"]</a></p>
</article></section>
