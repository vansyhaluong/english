@model English.Models.ViewModels.Listening.ListeningFormViewModel
@{ Layout = "_AdminLayout"; var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; ViewData["Title"] = L[Model.Id.HasValue ? "ListeningEdit" : "ListeningCreate"]; }
<section class="account-page"><div class="management-card">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post" class="account-form">
        <div asp-validation-summary="All" class="account-validation" role="alert"></div>
        <input asp-for="Input.RowVersion" type="hidden" />
        <div class="account-field"><label asp-for="Input.Title">@L["ListeningTitle"]</label><input asp-for="Input.Title" maxlength="300" required /><span asp-validation-for="Input.Title"></span></div>
        <div class="account-field"><label asp-for="Input.Description">@L["ClassificationDescription"]</label><textarea asp-for="Input.Description" rows="3"></textarea><span asp-validation-for="Input.Description"></span></div>
        <div class="account-field"><label asp-for="Input.LevelId">@L["Levels"]</label><select asp-for="Input.LevelId" required><option value="">@L["VocabSelect"]</option>@foreach (var option in Model.Choices.Levels) { <option value="@option.Id">@option.Name</option> }</select><span asp-validation-for="Input.LevelId"></span></div>
        <div class="account-field"><label asp-for="Input.TopicId">@L["Topics"]</label><select asp-for="Input.TopicId" required><option value="">@L["VocabSelect"]</option>@foreach (var option in Model.Choices.Topics) { <option value="@option.Id">@option.Name</option> }</select><span asp-validation-for="Input.TopicId"></span></div>
        @if (Model.CurrentAudioUrl is not null && English.Models.ListeningYouTubeUrl.GetVideoId(Model.CurrentAudioUrl) is null)
        { <p>@L["ListeningLegacyMedia"]: @Model.CurrentAudioUrl</p> }
        <div class="account-field"><label asp-for="Input.AudioUrl">@L["ListeningYouTubeUrl"]</label><input asp-for="Input.AudioUrl" type="url" maxlength="2048" placeholder="https://www.youtube.com/watch?v=VIDEO_ID" required="@(!Model.Id.HasValue || English.Models.ListeningYouTubeUrl.GetVideoId(Model.CurrentAudioUrl) is not null)" readonly="@Model.AudioLocked" aria-describedby="listening-video-hint" /><span asp-validation-for="Input.AudioUrl"></span></div>
        <p id="listening-video-hint">@L[Model.AudioLocked ? "ListeningVideoLocked" : Model.CurrentAudioUrl is not null && English.Models.ListeningYouTubeUrl.GetVideoId(Model.CurrentAudioUrl) is null ? "ListeningLegacyVideoHint" : "ListeningYouTubeHint"]</p>
        <label><input asp-for="Input.IsVisible" /> @L["VocabVisible"]</label>
        <button type="submit" class="btn-brand-primary">@L["SaveChanges"]</button>
    </form>
    @if (Model.Id.HasValue) { <p><a asp-action="Edit" asp-route-id="@Model.Id" asp-route-culture="@culture">@L["ClassificationReload"]</a></p> }
    <p><a asp-action="Index" asp-route-culture="@culture">@L["ClassificationBack"]</a></p>
</div></section>
