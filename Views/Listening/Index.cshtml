@using System.Text.Json
@{
    ViewData["Title"] = L["Listening"].Value;
    ViewData["PageClass"] = "listening-page";
    var keys = new[] { "Loading", "LoadError", "Unavailable", "Session", "HideTranscript", "ShowTranscript", "Learned", "NotLearned", "Mark", "Unmark", "Saving", "Saved", "SaveError", "Page", "Count", "Cues", "Video", "VideoPending", "VideoReadyError", "VideoApiError", "VideoUnavailable", "VideoEmbedError", "VideoIdentityError", "VideoError" };
    var labels = keys.ToDictionary(key => key, key => L["ListeningStudent" + key].Value);
    var english = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
    labels["Play"] = english ? "Play" : "Phát";
    labels["Pause"] = english ? "Pause" : "Tạm dừng";
    labels["Seek"] = english ? "Playback position" : "Vị trí phát";
    labels["PreviousCue"] = english ? "Previous sentence" : "Câu trước";
    labels["ReplayCue"] = english ? "Replay sentence" : "Nghe lại câu này";
    labels["NextCue"] = english ? "Next sentence" : "Câu sau";
}
@section Styles {
    <link rel="stylesheet" href="~/css/listening.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/combobox.css" asp-append-version="true" />
}
<section class="listening" aria-labelledby="listening-title" data-culture="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
    <header id="listening-heading" class="listening-heading"><h1 id="listening-title"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 14v-2a9 9 0 0 1 18 0v2M3 13h4v8H3zM17 13h4v8h-4z" /></svg>@L["Listening"]</h1><p>@L["ListeningStudentIntro"]</p></header>
    <noscript><p>@L["ListeningStudentJavascript"]</p></noscript>
    <div id="listening-message" role="status" aria-live="polite"></div>
    <button id="listening-retry" type="button" hidden>@L["ListeningStudentRetry"]</button>
    <div id="listening-catalog">
        <form id="listening-filters" class="listening-filters" role="search">
            <label class="listening-search">@L["ListeningSearch"]<input name="Search" type="search" maxlength="300" /></label>
            <div class="eh-combobox-field">
                <label for="listening-level">@L["Levels"]</label>
                <select id="listening-level" name="LevelId" data-eh-combobox><option value="">@L["ListeningStudentAllLevels"]</option></select>
            </div>
            <label>@L["Topics"]<select name="TopicId"><option value="">@L["ListeningStudentAllTopics"]</option></select></label>
            <button type="submit">@L["ListeningStudentSearch"]</button>
            <button type="button" id="listening-reset">@L["ListeningStudentReset"]</button>
        </form>
        <p id="listening-count" class="listening-muted" role="status"></p>
        <div id="listening-grid" class="listening-grid"></div>
        <p id="listening-empty" class="listening-panel" hidden>@L["ListeningEmpty"]</p>
        <nav id="listening-pagination" class="listening-actions" aria-label="@L["ListeningStudentPagination"]" hidden>
            <button type="button" id="listening-previous">@L["ListeningStudentPrevious"]</button>
            <span id="listening-page"></span>
            <button type="button" id="listening-next">@L["ListeningStudentNext"]</button>
        </nav>
    </div>
    <div id="listening-detail" hidden>
        <a id="listening-back" class="listening-back" href="?">@L["ListeningStudentBack"]</a>
        <article id="listening-lesson" hidden>
            <header class="listening-lesson-header">
                <div class="listening-lesson-info">
                    <h1 id="listening-lesson-title" tabindex="-1"></h1>
                    <p id="listening-meta" class="listening-meta"></p>
                    <p id="listening-description" class="listening-muted"></p>
                </div>
                <div class="listening-progress-actions">
                    <span id="listening-progress" class="listening-badge"></span>
                    <button id="listening-mark" type="button" aria-pressed="false"></button>
                    <span id="listening-save-status" role="status" aria-live="polite"></span>
                </div>
            </header>
            <div class="listening-workspace">
                <div class="listening-player-panel">
                    <audio id="listening-audio" controls controlslist="noplaybackrate nodownload" preload="metadata" aria-label="@L["ListeningStudentAudio"]"></audio>
                    <p id="listening-audio-error" role="alert" hidden>@L["ListeningStudentAudioError"]</p>
                    <div id="listening-video" class="listening-video" hidden></div>
                    <div id="listening-player-controls" class="listening-player-controls" hidden>
                        <button id="listening-play" type="button" aria-label="@labels["Play"]" title="@labels["Play"]" disabled>
                            <svg class="listening-play-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
                            <svg class="listening-pause-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
                        </button>
                        <input id="listening-seek" type="range" min="0" max="1000" value="0" step="1" aria-label="@labels["Seek"]" disabled />
                        <span id="listening-playback-time" class="listening-playback-time">0:00 / 0:00</span>
                    </div>
                    <p id="listening-video-status" role="status" aria-live="polite" hidden></p>
                </div>
                <section class="listening-transcript-panel" aria-labelledby="listening-transcript-title">
                    <div class="listening-transcript-heading">
                        <div><h2 id="listening-transcript-title">@L["ListeningStudentTranscript"]</h2><span id="listening-cue-count" class="listening-muted"></span></div>
                        <button id="listening-toggle" type="button" aria-expanded="true" aria-controls="listening-transcript">@L["ListeningStudentHideTranscript"]</button>
                    </div>
                    <p id="listening-no-cues" hidden>@L["ListeningStudentNoCues"]</p>
                    <p id="listening-cue-hint" class="listening-muted">@L["ListeningStudentCueHint"]</p>
                    <div id="listening-transcript" class="listening-transcript" role="region" aria-label="@L["ListeningStudentTranscript"]" tabindex="0"><ol id="listening-cues"></ol></div>
                    <div id="listening-cue-controls" class="listening-cue-controls" role="group" aria-label="@L["ListeningStudentTranscript"]" hidden>
                        <button id="listening-cue-previous" type="button" aria-label="@labels["PreviousCue"]" title="@labels["PreviousCue"]" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 5v14m12-14L8 12l10 7Z" /></svg></button>
                        <button id="listening-cue-replay" type="button" aria-label="@labels["ReplayCue"]" title="@labels["ReplayCue"]" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 10a8 8 0 1 1 1 7M4 4v6h6" /></svg></button>
                        <button id="listening-cue-next" type="button" aria-label="@labels["NextCue"]" title="@labels["NextCue"]" disabled><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M18 5v14M6 5l10 7-10 7Z" /></svg></button>
                    </div>
                </section>
            </div>
        </article>
    </div>
</section>
<script id="listening-labels" type="application/json">@Html.Raw(JsonSerializer.Serialize(labels))</script>
@section Scripts {
    <script src="~/js/combobox.js" asp-append-version="true" defer></script>
    <script src="~/js/listening.js" asp-append-version="true" defer></script>
}
