@model English.Models.ViewModels.Grammar.GrammarFormViewModel
@{ Layout = "_AdminLayout"; var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; ViewData["Title"] = L[Model.Id.HasValue ? "GrammarEdit" : "GrammarCreate"]; }
@section Styles { <link rel="stylesheet" href="~/css/grammar-content.css" asp-append-version="true" /> }
<section class="account-page grammar-content"><div class="management-card">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="@(Model.Id.HasValue ? "Edit" : "Create")" asp-route-id="@Model.Id" asp-route-culture="@culture" method="post" class="account-form">
        <div asp-validation-summary="All" class="account-validation" role="alert"></div><input asp-for="Input.RowVersion" type="hidden" />
        <div class="account-field"><label asp-for="Input.Title">@L["GrammarTitle"]</label><input asp-for="Input.Title" maxlength="300" required /><span asp-validation-for="Input.Title"></span></div>
        <div class="account-field"><label asp-for="Input.Description">@L["ClassificationDescription"]</label><textarea asp-for="Input.Description" rows="2"></textarea><span asp-validation-for="Input.Description"></span></div>
        <div class="account-field"><label asp-for="Input.LevelId">@L["Levels"]</label><select asp-for="Input.LevelId" required><option value="">@L["VocabSelect"]</option>@foreach (var level in Model.Choices.Levels) { <option value="@level.Id">@level.Name</option> }</select><span asp-validation-for="Input.LevelId"></span></div>
        <div class="account-field"><label asp-for="Input.GrammarGroupId">@L["GrammarGroups"]</label><select asp-for="Input.GrammarGroupId" required><option value="">@L["VocabSelect"]</option>@foreach (var group in Model.Choices.Groups) { <option value="@group.Id">@group.Name</option> }</select><span asp-validation-for="Input.GrammarGroupId"></span></div>
        <p id="grammar-editor-hint">@L["GrammarEditorHint"]</p>
        <div class="account-field grammar-editor"><label asp-for="Input.Formula">@L["GrammarFormula"]</label><textarea asp-for="Input.Formula" rows="4" required aria-describedby="grammar-editor-hint"></textarea><span asp-validation-for="Input.Formula"></span></div>
        <div class="account-field grammar-editor"><label asp-for="Input.Usage">@L["GrammarUsage"]</label><textarea asp-for="Input.Usage" rows="6" required aria-describedby="grammar-editor-hint"></textarea><span asp-validation-for="Input.Usage"></span></div>
        <div class="account-field grammar-editor"><label asp-for="Input.Examples">@L["GrammarExamples"]</label><textarea asp-for="Input.Examples" rows="5" required aria-describedby="grammar-editor-hint"></textarea><span asp-validation-for="Input.Examples"></span></div>
        <div class="account-field grammar-editor"><label asp-for="Input.Notes">@L["GrammarNotes"]</label><textarea asp-for="Input.Notes" rows="4" aria-describedby="grammar-editor-hint"></textarea><span asp-validation-for="Input.Notes"></span></div>
        <label><input asp-for="Input.IsVisible" /> @L["VocabVisible"]</label>
        <button type="submit" class="btn-brand-primary">@L["SaveChanges"]</button>
    </form>
    <template id="grammar-editor-tools"><div class="grammar-actions" role="group" aria-label="@L["GrammarFormatting"]"><button type="button" data-format="strong">@L["GrammarBold"]</button><button type="button" data-format="em">@L["GrammarItalic"]</button><button type="button" data-format="ul">@L["GrammarBullets"]</button><button type="button" data-format="ol">@L["GrammarNumbered"]</button><button type="button" data-format="table">@L["GrammarTable"]</button></div></template>
    @if (Model.Id.HasValue) { <p><a asp-action="Edit" asp-route-id="@Model.Id" asp-route-culture="@culture">@L["ClassificationReload"]</a></p> }
    <p><a asp-action="Index" asp-route-culture="@culture">@L["ClassificationBack"]</a></p>
</div></section>
@section Scripts { <script src="~/js/grammar-editor.js" asp-append-version="true" defer></script> }
