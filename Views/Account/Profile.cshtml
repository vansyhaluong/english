@model English.Models.ViewModels.Account.ProfileViewModel
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Layout = User.IsInRole(nameof(UserRole.Admin))
        ? "_AdminLayout"
        : User.IsInRole(nameof(UserRole.Student))
            ? "_StudentLayout"
            : "_Layout";
    ViewData["Title"] = L["Profile"];
}

<section class="account-page" aria-labelledby="profile-title">
    <div class="account-card">
        <h1 id="profile-title">@L["ProfileTitle"]</h1>

        @if (TempData["AccountMessage"] is string message)
        {
            <p class="account-success" role="status">@message</p>
        }

        <dl class="account-readonly">
            <div>
                <dt>@L["Email"]</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>@L["Role"]</dt>
                <dd>@L[Model.Role]</dd>
            </div>
        </dl>

        <form asp-action="Profile" asp-route-culture="@culture" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" />
                <span asp-validation-for="FullName"></span>
            </div>

            <button type="submit" class="btn-brand-primary account-submit">@L["SaveChanges"]</button>
        </form>

        <p class="account-switch"><a asp-action="ChangePassword" asp-route-culture="@culture">@L["ChangePassword"]</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
