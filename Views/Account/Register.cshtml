@model English.Models.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "Đăng ký";
    ViewData["PageClass"] = "account-page-shell";
}

<section class="account-page" aria-labelledby="register-title">
    <div class="account-card">
        <img src="~/images/learning-mascot.png" alt="" width="80" height="80" class="login-mascot" />
        <h1 id="register-title">Tạo tài khoản</h1>
        <p class="account-intro">Bắt đầu lưu tiến độ học tiếng Anh của bạn.</p>

        <form asp-action="Register" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" autocomplete="name" />
                <span asp-validation-for="FullName"></span>
            </div>

            <div class="account-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="account-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" value="" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <div class="account-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" value="" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn-brand-primary account-submit">Đăng ký</button>
        </form>

        <p class="account-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
