@model English.Models.ViewModels.Account.ChangePasswordViewModel
@{
    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    Layout = User.IsInRole(nameof(UserRole.Admin))
        ? "_AdminLayout"
        : User.IsInRole(nameof(UserRole.Student))
            ? "_StudentLayout"
            : "_Layout";
    ViewData["Title"] = L["ChangePassword"];
}

<section class="account-page" aria-labelledby="change-password-title">
    <div class="account-card">
        <h1 id="change-password-title">@L["ChangePasswordTitle"]</h1>

        @if (TempData["AccountMessage"] is string message)
        {
            <p class="account-success" role="status">@message</p>
        }

        <form asp-action="ChangePassword" asp-route-culture="@culture" method="post" class="account-form">
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" type="password" value="" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword"></span>
            </div>

            <div class="account-field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" type="password" value="" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>

            <div class="account-field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" type="password" value="" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button type="submit" class="btn-brand-primary account-submit">@L["UpdatePassword"]</button>
        </form>

        <p class="account-switch"><a asp-action="Profile" asp-route-culture="@culture">@L["BackToProfile"]</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
