@model English.Models.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["PageClass"] = "account-page-shell";
}

<section class="account-page" aria-labelledby="login-title">
    <div class="account-card">
        <img src="~/images/learning-mascot.png" alt="" width="80" height="80" class="login-mascot" />
        <h1 id="login-title">Đăng nhập EnglishHub</h1>
        <p class="account-intro">Tiếp tục hành trình học và lưu tiến độ của bạn.</p>

        @if (TempData["AccountMessage"] is string message)
        {
            <p class="account-success" role="status">@message</p>
        }

        <form asp-action="Login" method="post" class="account-form">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="account-validation" role="alert"></div>

            <div class="account-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="account-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" value="" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>

            <button type="submit" class="btn-brand-primary account-submit">Đăng nhập</button>
        </form>

        <p class="account-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
